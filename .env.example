# Copie este arquivo para .env e ajuste os valores.
# O arquivo .env fica de fora do Git (.gitignore).

# Chave usada para sessões e CSRF. Troque por uma sequência longa e aleatória.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# 1 no desenvolvimento (o runserver entrega os arquivos estáticos). Use 0 em produção.
# No Render o Blueprint define 0. Sem esta variável, o debug também fica desligado
# quando a plataforma define RENDER=true.
DJANGO_DEBUG=1

# Hosts separados por vírgula. O padrão do código inclui .onrender.com.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Origens HTTPS autorizadas a enviar formulários, separadas por vírgula.
# No Render a URL pública (RENDER_EXTERNAL_URL) entra sozinha nesta lista.
# Exemplo de domínio próprio: https://ozzy-gestao.exemplo.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Sem DATABASE_URL o Django usa SQLite (db.sqlite3). É o caminho do plano
# gratuito do Render: o disco é efêmero e o start semeia os dados de novo.
# Para PostgreSQL, descomente e ajuste. O usuário e a senha abaixo são fictícios.
# DATABASE_URL=postgres://ozzy:senha-ficticia@localhost:5432/ozzy_gestao

# Senha do usuário de demonstração criado por `python manage.py seed_demo`.
# Só é aplicada na primeira criação. Não use esta senha em produção.
DEMO_PASSWORD=acai-demo-2026
